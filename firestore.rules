// AI-GENERATED by Claude (Claude Code), 2026-09-23
rules_version = '2';

// Threat model (docs/ROADMAP.md, 2026-09-18): the client is untrusted input,
// rules validate ownership, shape and bounds; a user cheating their own
// progress has no victim and is not defended against beyond those bounds.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    // Profile: onboarding answers, written once by onboarding 04.
    match /users/{uid} {
      function validProfile(data) {
        return data.keys().hasOnly(['level', 'dailyGoalMinutes', 'createdAt'])
          && data.level in ['never', 'seen', 'some']
          && data.dailyGoalMinutes in [5, 10, 15, 20];
      }

      allow read: if isOwner(uid);
      // createdAt must be the server timestamp, never a device clock.
      allow create: if isOwner(uid)
        && validProfile(incoming())
        && incoming().createdAt == request.time;
      // Answers may change later (settings); the creation date may not.
      allow update: if isOwner(uid)
        && validProfile(incoming())
        && incoming().createdAt == resource.data.createdAt;
      allow delete: if false;

      // Progress: one document, appended to by lesson completions only.
      match /progress/current {
        function validProgress(data) {
          return data.keys().hasOnly(['completedLessonIds', 'xp', 'updatedAt'])
            && data.completedLessonIds is list
            && data.xp is int
            && data.updatedAt == request.time;
        }

        allow read: if isOwner(uid);
        // First completion creates the document: at most one lesson, its XP.
        allow create: if isOwner(uid)
          && validProgress(incoming())
          && incoming().completedLessonIds.size() <= 1
          && incoming().xp >= 0
          && incoming().xp <= 100;
        // Every later write adds exactly one new lesson and 1..100 XP; ids
        // never disappear, XP never goes down.
        allow update: if isOwner(uid)
          && validProgress(incoming())
          && incoming().completedLessonIds.hasAll(resource.data.completedLessonIds)
          && incoming().completedLessonIds.size() == resource.data.completedLessonIds.size() + 1
          && incoming().xp - resource.data.xp >= 1
          && incoming().xp - resource.data.xp <= 100;
        allow delete: if false;
      }
    }
  }
}
